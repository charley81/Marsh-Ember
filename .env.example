# Select "fixtures" for credential-free local/CI builds or "sanity" for connected content.
CONTENT_SOURCE=fixtures

# Public Sanity identifiers. Required when CONTENT_SOURCE=sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Secret Viewer token used only by server-side draft preview.
SANITY_API_READ_TOKEN=your-viewer-token

# Optional local-only Editor token. Add only for an explicitly approved migration write.
# SANITY_API_WRITE_TOKEN=your-temporary-editor-token
