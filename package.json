{
  "name": "marsh-ember",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "studio:dev": "pnpm --dir studio dev",
    "studio:build": "pnpm --dir studio build",
    "sanity:typegen": "pnpm --dir studio typegen",
    "sanity:validate": "pnpm --dir studio validate",
    "content:migrate:dry-run": "tsx migration/scripts/migrate.ts",
    "content:migrate:write": "tsx migration/scripts/migrate.ts --write",
    "content:migrate:validate": "tsx migration/scripts/validate.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "lint": "eslint && pnpm --dir studio lint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm lint && pnpm sanity:typegen && pnpm typecheck && pnpm test && pnpm studio:build && pnpm build"
  },
  "dependencies": {
    "@sanity/client": "7.26.2",
    "@sanity/image-url": "2.1.1",
    "next": "16.3.1",
    "next-sanity": "13.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@vercel/frameworks>js-yaml": "3.15.1",
      "@vercel/frameworks>smol-toml": "1.6.1",
      "typeid-js>uuid": "11.1.1"
    }
  }
}
